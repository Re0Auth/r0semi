# What the image build does not need. Keeping the context small is not just
# speed: anything copied into a layer can leak into an intermediate one, so
# deployment-local secrets and the tool's own state stay out.

.git
.github
.commandcode

# Build output and local binaries: the image builds its own.
dist
re0auth
referencesource
*.exe

# The frontend is installed and built inside the web stage from the lockfile, so
# a host node_modules or build cache must never be copied in and shadow it.
web/node_modules
web/.svelte-kit
web/test-results
web/playwright-report

# Replaced by the web stage's output; the source-tree placeholder is not needed.
internal/webui/dist

# Deployment-local configuration and secrets. The example files stay (they are
# documentation), but a real config and any *.local/*.secret file must not enter
# an image layer.
config/re0auth.toml
config/*.local.*
config/*.secret.*
.env

# The backup scripts' default output (scripts/backup.sh:12, backup-keys.sh:23):
# a plaintext SQL dump and a KEK/OIDC/audit-key .env. Same reason as .env above.
backups
*.dump
*.env

# The audit workspaces and the other local state .gitignore excludes. The build
# needs none of it: scratchpad/ is where a running audit leaves probes and
# generated material — including key-shaped files — and _audit/, AUDIT-ISSUES.md
# and the audit reports are the round's raw record, which .gitleaks.toml exempts
# precisely because it quotes token-shaped output. None of it may reach the build
# context or the backend stage's `COPY . .` layer (Dockerfile:53).
scratchpad
_audit
AUDIT-ISSUES.md
docs/security-audit-*.md
go.work
go.work.sum
*.local.toml
*.out
bench.txt
load.txt
report.md

# Key, certificate and private-key shapes. The build reads no key from the
# context — the CA bundle comes from the pinned base stage (Dockerfile:70) — so a
# stray key anywhere in the tree must not be uploaded with the context and land in
# an intermediate layer. A .dockerignore pattern without a slash is matched
# against the path relative to the context root, so a bare `*.pem` covers the root
# only; the `**/` twin is what covers the directories below it.
*.pem
**/*.pem
*.key
**/*.key
*.p12
**/*.p12
*.crt
**/*.crt
*.jks
**/*.jks

# Editor and VCS noise.
.gitignore
.vscode
.idea

# What the image build does not need. Keeping the context small is not just
# speed: anything copied into a layer can leak into an intermediate one, so
# deployment-local secrets and the tool's own state stay out.

.git
.github
.commandcode

# Build output and local binaries: the image builds its own.
dist
re0auth
referencesource
*.exe

# The frontend is installed and built inside the web stage from the lockfile, so
# a host node_modules or build cache must never be copied in and shadow it.
web/node_modules
web/.svelte-kit
web/test-results
web/playwright-report

# Replaced by the web stage's output; the source-tree placeholder is not needed.
internal/webui/dist

# Deployment-local configuration and secrets. The example files stay (they are
# documentation), but a real config and any *.local/*.secret file must not enter
# an image layer.
config/re0auth.toml
config/*.local.*
config/*.secret.*
.env

# The backup scripts' default output (scripts/backup.sh:12, backup-keys.sh:23):
# a plaintext SQL dump and a KEK/OIDC/audit-key .env. Same reason as .env above.
backups
*.dump
*.env

# The audit workspace and the other local state .gitignore excludes. The build
# needs none of it, and scratchpad/ is where audits leave probes and generated
# material — including key-shaped files — so it must not reach the build context
# or the backend stage's `COPY . .` layer (Dockerfile:42).
scratchpad
go.work
go.work.sum
*.local.toml
*.out
bench.txt
load.txt
report.md

# Editor and VCS noise.
.gitignore
.vscode
.idea
